# Copy to .env and fill in. All secrets are read from the environment (or a git-ignored secrets/ dir).
# NEVER commit real values.

# --- Database ---
# Path to the SQLite leads database (default: ./leads.db)
LEADGEN_DB=leads.db

# --- Discovery ---
# Apify API token, used by scrape_places_apify.py (primary discovery).
# Get one at https://console.apify.com/account/integrations
APIFY_TOKEN=
# Optional: only for the legacy Google Places scripts (scrape_places.py / text_search_places.py)
GOOGLE_PLACES_API_KEY=

# --- Apollo (sequence enrollment) ---
# Apollo API key. Required only for live enrollment (sync_to_apollo.py --sync-live).
APOLLO_API_KEY=
# Optional base URL override (defaults to https://api.apollo.io/v1)
APOLLO_BASE_URL=
# Optional Apollo custom-field IDs for snippet mail-merge (tenant-specific; leave blank to skip snippets)
APOLLO_CF_SNIPPET_SUBJECT=
APOLLO_CF_SNIPPET_HOOK=
APOLLO_CF_SNIPPET_BODY=
